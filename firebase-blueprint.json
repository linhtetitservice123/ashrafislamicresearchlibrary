{
  "entities": {
    "Paper": {
      "title": "Islamic Research Paper",
      "description": "Scholarly Islamic research paper or classical Islamic book entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "titleOriginalScript": { "type": "string", "maxLength": 300 },
        "author": { "type": "string", "maxLength": 150 },
        "authorTitle": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 64 },
        "language": { "type": "string", "maxLength": 32 },
        "publicationYear": { "type": "string", "maxLength": 32 },
        "abstract": { "type": "string", "maxLength": 4000 },
        "fullContent": { "type": "string", "maxLength": 100000 },
        "tags": { "type": "array" },
        "pages": { "type": "number" },
        "downloadCount": { "type": "number" },
        "readCount": { "type": "number" },
        "uploadedAt": { "type": "string", "maxLength": 64 },
        "fileFormat": { "type": "string", "maxLength": 16 },
        "fileSize": { "type": "string", "maxLength": 32 },
        "isVerifiedByAcademy": { "type": "boolean" },
        "referenceNumber": { "type": "string", "maxLength": 64 },
        "featured": { "type": "boolean" },
        "telegramLink": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "title", "author", "category", "language", "abstract"]
    },
    "PaperRequest": {
      "title": "Paper Research Request",
      "description": "User requested book or Islamic research paper topic",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "topic": { "type": "string", "maxLength": 300 },
        "requesterName": { "type": "string", "maxLength": 150 },
        "requesterContact": { "type": "string", "maxLength": 100 },
        "contactType": { "type": "string", "enum": ["whatsapp", "phone", "email"] },
        "language": { "type": "string", "maxLength": 32 },
        "category": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 3000 },
        "status": { "type": "string", "enum": ["pending", "in_research", "fulfilled"] },
        "submittedAt": { "type": "string", "maxLength": 64 },
        "adminNotes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "topic", "requesterName", "requesterContact", "category", "description", "status", "submittedAt"]
    },
    "UserSubmittedFatwa": {
      "title": "Fatwa Inquiry",
      "description": "Community question submitted for Islamic legal ruling (Fatwa)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "enum": ["namaz", "roza", "hajj", "zakat", "trade_business", "amal"] },
        "question": { "type": "string", "maxLength": 4000 },
        "inquirerName": { "type": "string", "maxLength": 150 },
        "contactNumber": { "type": "string", "maxLength": 100 },
        "contactType": { "type": "string", "enum": ["whatsapp", "telegram", "phone"] },
        "city": { "type": "string", "maxLength": 100 },
        "isAnonymous": { "type": "boolean" },
        "submittedAt": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["pending", "answered"] },
        "answerText": { "type": "string", "maxLength": 10000 },
        "kitabReference": { "type": "string", "maxLength": 500 },
        "scholarName": { "type": "string", "maxLength": 200 },
        "answeredAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "category", "question", "inquirerName", "contactNumber", "contactType", "isAnonymous", "submittedAt", "status"]
    },
    "PublishedFatwa": {
      "title": "Published Official Fatwa",
      "description": "Official Fatwa entry managed by Admin and synced in real-time to all visitors",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "fatwaNumber": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "enum": ["namaz", "roza", "hajj", "zakat", "trade_business", "amal"] },
        "question": { "type": "string", "maxLength": 4000 },
        "questionerName": { "type": "string", "maxLength": 150 },
        "location": { "type": "string", "maxLength": 100 },
        "askedDate": { "type": "string", "maxLength": 64 },
        "answeredDate": { "type": "string", "maxLength": 64 },
        "answerSummary": { "type": "string", "maxLength": 2000 },
        "answerDetail": { "type": "string", "maxLength": 15000 },
        "arabicReference": { "type": "string", "maxLength": 2000 },
        "kitabReference": { "type": "string", "maxLength": 500 },
        "scholarName": { "type": "string", "maxLength": 200 },
        "scholarTitle": { "type": "string", "maxLength": 200 },
        "isVerified": { "type": "boolean" },
        "viewsCount": { "type": "number" },
        "tags": { "type": "array" }
      },
      "required": ["id", "fatwaNumber", "category", "question", "answerSummary", "answerDetail", "kitabReference", "scholarName"]
    },
    "AdminContact": {
      "title": "Organization Team Member",
      "description": "Official team member or scholar contact entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "nameMy": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "maxLength": 150 },
        "roleMy": { "type": "string", "maxLength": 150 },
        "whatsappNumber": { "type": "string", "maxLength": 64 },
        "displayWhatsapp": { "type": "string", "maxLength": 64 },
        "phoneNumber": { "type": "string", "maxLength": 64 },
        "displayPhone": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 200 },
        "activeHours": { "type": "string", "maxLength": 150 },
        "specialization": { "type": "string", "maxLength": 300 },
        "avatarSeed": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "nameMy", "roleMy", "phoneNumber", "whatsappNumber"]
    },
    "AppSetting": {
      "title": "Application Configuration",
      "description": "Global application setting such as Telegram Channel URL",
      "type": "object",
      "properties": {
        "key": { "type": "string", "maxLength": 64 },
        "value": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["key", "value"]
    },
    "SiteConfig": {
      "title": "Global Site Configuration",
      "description": "Whole-system branding, announcements, feature toggles, Fatwa notices, and footer texts synced in real-time",
      "type": "object",
      "properties": {
        "siteNameEn": { "type": "string", "maxLength": 120 },
        "siteNameMy": { "type": "string", "maxLength": 150 },
        "heroTitleMy": { "type": "string", "maxLength": 200 },
        "heroSubtitle": { "type": "string", "maxLength": 1000 },
        "searchPlaceholder": { "type": "string", "maxLength": 200 },
        "announcementEnabled": { "type": "boolean" },
        "announcementText": { "type": "string", "maxLength": 500 },
        "announcementType": { "type": "string", "enum": ["info", "warning", "success"] },
        "maintenanceMode": { "type": "boolean" },
        "maintenanceMessage": { "type": "string", "maxLength": 1000 },
        "enableFatwaSection": { "type": "boolean" },
        "enableFatwaSubmission": { "type": "boolean" },
        "enableContactTab": { "type": "boolean" },
        "enableWhatsappFloat": { "type": "boolean" },
        "enableTelegramButtons": { "type": "boolean" },
        "showDefaultSampleFatwas": { "type": "boolean" },
        "fatwaTitle": { "type": "string", "maxLength": 200 },
        "fatwaSubtitle": { "type": "string", "maxLength": 1000 },
        "fatwaNotice1": { "type": "string", "maxLength": 1000 },
        "fatwaNotice2": { "type": "string", "maxLength": 1000 },
        "fatwaWhatsappNumber": { "type": "string", "maxLength": 64 },
        "footerDescription": { "type": "string", "maxLength": 1000 },
        "contactEmail": { "type": "string", "maxLength": 200 },
        "footerCopyright": { "type": "string", "maxLength": 200 },
        "footerTagline": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 254 }
      },
      "required": ["siteNameEn", "siteNameMy", "heroTitleMy", "heroSubtitle"]
    },
    "AdminUser": {
      "title": "Authorized Admin Account",
      "description": "Gmail accounts granted Admin Control Panel access",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 254 },
        "name": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["owner", "admin"] },
        "addedAt": { "type": "string", "maxLength": 64 },
        "addedBy": { "type": "string", "maxLength": 254 }
      },
      "required": ["email", "role", "addedAt", "addedBy"]
    }
  },
  "firestore": {
    "/papers/{paperId}": {
      "schema": "Paper",
      "description": "Islamic research papers, classical texts, and references"
    },
    "/requests/{requestId}": {
      "schema": "PaperRequest",
      "description": "Community book and paper request board"
    },
    "/fatwa_inquiries/{inquiryId}": {
      "schema": "UserSubmittedFatwa",
      "description": "Fatwa questions submitted by community members"
    },
    "/published_fatwas/{fatwaId}": {
      "schema": "PublishedFatwa",
      "description": "Official Fatwa archive managed by Admin and synced live to all visitors"
    },
    "/team_members/{memberId}": {
      "schema": "AdminContact",
      "description": "Organization team members and contact numbers managed by Admin"
    },
    "/settings/{settingId}": {
      "schema": "AppSetting",
      "description": "Global app configurations such as Telegram Channel DB link"
    },
    "/site_config/{configId}": {
      "schema": "SiteConfig",
      "description": "Whole-system branding, announcements, feature toggles, Fatwa notices, and footer settings"
    },
    "/admin_users/{adminEmail}": {
      "schema": "AdminUser",
      "description": "Authorized Admin Gmail accounts managed by Owner/Admins"
    }
  }
}
